{
  "biome.enabled": true,
  "editor.autoIndent": "advanced",
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "editor.rulers": [80, 120],
  "editor.smoothScrolling": true,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.tabSize": 2,
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit",
    "quickfix.biome": "explicit"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.quoteStyle": "single",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.preferences.quoteStyle": "single",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.eol": "\n",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "github.gitProtocol": "ssh",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {},
  "workbench.editor.decorations.badges": true,
  "workbench.fontAliasing": "antialiased",
  "workbench.list.smoothScrolling": true,
  "workbench.settings.applyToAllProfiles": [
    "typescript.preferences.quoteStyle"
  ],
  "workbench.tree.indent": 12,
  "workbench.iconTheme": "vscode-icons",
  "window.zoomLevel": 0.25,
  "diffEditor.maxComputationTime": 0,
  "extensions.ignoreRecommendations": true,
  "redhat.telemetry.enabled": false,
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
  "atlascode.bitbucket.enabled": false,
  "atlascode.jira.explorer.fetchAllQueryResults": true,
  "atlascode.jira.jqlList": [],
  "cursor.diffs.useCharacterLevelDiffs": true,
  "cursor.cmdk.useThemedDiffBackground": true,
  "cursor.chat.showSuggestedFiles": true,
  "cursor.chat.defaultNoContext": true,
  "cursor.chat.smoothStreaming": true,
  "cursor.chat.premiumChatAutoScrollWhenAtBottom": true,
  "cursor.chat.collapseInputBoxPills": true,
  "cursor.cpp.enablePartialAccepts": true,
  "cursor.composer.showSuggestedFiles": true,
  "cursor.composer.collapsePaneInputBoxPills": true,
  "cursor.composer.shouldAllowCustomModes": true,
  "cursor.composer.textSizeScale": 1.3,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.composer.usageSummaryDisplay": "always",
  "cursor.general.gitGraphIndexing": "enabled",
  "cursor.terminal.usePreviewBox": true,
  "cursor.windowSwitcher.sidebarHoverCollapsed": true,
  "cursor.agent_layout_browser_beta_setting": true,
  "cursor.enable_git_worktrees_setting": true
}
